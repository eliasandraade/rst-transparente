// Prisma Schema — Orken COND
// Cada condomínio é uma organização; todo dado de domínio pertence a uma
// (organizationId), isolado no backend (lib/tenant.ts) e no banco (RLS).
// docs/orken-cond/arquitetura.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Usuários da área administrativa ─────────────────────────────────────────

model User {
  id                   String              @id @default(cuid())
  organizationId       String?             @db.Uuid
  organization         Organization?       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email                String
  name                 String
  password             String
  role                 Role                @default(CONSELHO)
  ativo                Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  demandUpdates        DemandUpdate[]
  notificacoesEmitidas Notificacao[]       @relation("NotificacaoCriador")
  multasAplicadas      Multa[]             @relation("MultaCriador")
  juridicoAuditorias   JuridicoAuditoria[] @relation("JuridicoAuditor")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

enum Role {
  MASTER
  SINDICO
  GESTAO
  CONSELHO
}

// ─── Categorias financeiras ───────────────────────────────────────────────────

model Categoria {
  id             String         @id @default(cuid())
  organizationId String?        @db.Uuid
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  nome           String
  tipo           TipoLancamento
  cor            String         @default("#64748B") // hex para gráficos
  ativo          Boolean        @default(true)
  ordem          Int            @default(0)
  lancamentos    Lancamento[]
  createdAt      DateTime       @default(now())

  @@index([organizationId])
  @@map("categorias")
}

enum TipoLancamento {
  RECEITA
  DESPESA
}

// ─── Lançamentos financeiros (receitas e despesas) ────────────────────────────

model Lancamento {
  id             String           @id @default(cuid())
  organizationId String?          @db.Uuid
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tipo           TipoLancamento
  categoriaId    String
  categoria      Categoria        @relation(fields: [categoriaId], references: [id])
  descricao      String
  valor          Decimal          @db.Decimal(12, 2)
  data           DateTime         @db.Date
  fornecedor     String?
  observacoes    String?
  periodo        String // "2025-03" (YYYY-MM)
  status         StatusPublicacao @default(RASCUNHO)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([periodo])
  @@index([tipo])
  @@index([status])
  @@index([organizationId])
  @@map("lancamentos")
}

enum StatusPublicacao {
  RASCUNHO
  PUBLICADO
}

// ─── Pareceres do Conselho Fiscal ─────────────────────────────────────────────

model Parecer {
  id              String           @id @default(cuid())
  organizationId  String?          @db.Uuid
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  periodoRef      String // "2025-03" (YYYY-MM)
  titulo          String
  texto           String?          @db.Text
  arquivoUrl      String? // URL do PDF no Cloudinary
  arquivoNome     String? // Nome original do arquivo
  dataEmissao     DateTime         @db.Date
  membrosConselho String? // Nomes separados por ponto-e-vírgula
  status          StatusPublicacao @default(RASCUNHO)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([periodoRef])
  @@index([status])
  @@index([organizationId])
  @@map("pareceres")
}

// ─── Planilhas para download ──────────────────────────────────────────────────

model PlanilhaDownload {
  id             String        @id @default(cuid())
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  periodo        String // "YYYY-MM"
  arquivoUrl     String
  arquivoNome    String
  createdAt      DateTime      @default(now())

  @@index([periodo])
  @@index([organizationId])
  @@map("planilhas_download")
}

// ─── Avisos e informativos ────────────────────────────────────────────────────

model Aviso {
  id             String           @id @default(cuid())
  organizationId String?          @db.Uuid
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  titulo         String
  corpo          String           @db.Text
  fixado         Boolean          @default(false)
  status         StatusPublicacao @default(RASCUNHO)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("avisos")
}

// ─── Obras e melhorias (seção Gestão) ────────────────────────────────────────

model Obra {
  id             String        @id @default(cuid())
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  titulo         String
  descricao      String?       @db.Text
  orcamento      Decimal?      @db.Decimal(12, 2)
  gasto          Decimal?      @db.Decimal(12, 2)
  status         StatusObra    @default(PLANEJADO)
  progresso      Int           @default(0) // 0–100
  dataInicio     DateTime?     @db.Date
  dataPrevista   DateTime?     @db.Date
  imagemUrl      String?
  publicado      Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@map("obras")
}

enum StatusObra {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

// ─── Propostas dos moradores ──────────────────────────────────────────────────

model Proposta {
  id             String         @id @default(cuid())
  organizationId String?        @db.Uuid
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  texto          String         @db.Text
  nome           String?
  unidade        String?
  status         StatusProposta @default(PENDENTE)
  resposta       String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@map("propostas")
}

enum StatusProposta {
  PENDENTE
  ANALISANDO
  RESPONDIDA
  ARQUIVADA
}

// ─── Enquetes ─────────────────────────────────────────────────────────────────

model Enquete {
  id             String           @id @default(cuid())
  organizationId String?          @db.Uuid
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  pergunta       String
  tipo           TipoEnquete      @default(UNICA)
  status         StatusPublicacao @default(RASCUNHO)
  dataFim        DateTime?
  opcoes         OpcaoEnquete[]
  votos          VotoEnquete[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status])
  @@index([organizationId])
  @@map("enquetes")
}

enum TipoEnquete {
  UNICA
  MULTIPLA
}

model OpcaoEnquete {
  id             String        @id @default(cuid())
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enqueteId      String
  enquete        Enquete       @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  texto          String
  ordem          Int           @default(0)
  votos          VotoEnquete[]

  @@index([organizationId])
  @@map("opcoes_enquete")
}

model VotoEnquete {
  id             String        @id @default(cuid())
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  enqueteId      String
  enquete        Enquete       @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  opcaoId        String
  opcao          OpcaoEnquete  @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  ip             String
  createdAt      DateTime      @default(now())

  @@unique([enqueteId, opcaoId, ip])
  @@index([organizationId])
  @@map("votos_enquete")
}

// ─── Membros da gestão (página Quem Somos) ────────────────────────────────────

model Membro {
  id             String        @id @default(cuid())
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  nome           String
  cargo          String
  descricao      String?       @db.Text
  fotoUrl        String?
  ordem          Int           @default(0)
  ativo          Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@map("membros")
}

// ─── Configuração do portal ───────────────────────────────────────────────────

model ConfigPortal {
  id             String        @id @default(cuid())
  organizationId String?       @unique @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  nomeCondominio String        @default("")
  cnpj           String?
  endereco       String?
  logoUrl        String?
  periodoAtivo   String        @default("") // Período padrão exibido nas páginas públicas
  updatedAt      DateTime      @updatedAt

  @@map("config_portal")
}

// ─── Central de Demandas ──────────────────────────────────────────────────────

enum DemandCategory {
  MANUTENCAO
  SEGURANCA
  LIMPEZA
  FINANCEIRO
  BARULHO
  ILUMINACAO
  VAZAMENTO
  SUGESTAO
  RECLAMACAO
  OUTROS
}

enum DemandStatus {
  RECEBIDA
  EM_ANALISE
  EM_ANDAMENTO
  RESOLVIDA
  ENCERRADA_SEM_ACAO
}

model Demand {
  id             String         @id @default(cuid())
  organizationId String?        @db.Uuid
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  protocol       String
  accessCode     String
  requesterName  String
  unit           String
  email          String?
  phone          String
  ipAddress      String?
  userAgent      String?
  category       DemandCategory
  title          String
  description    String         @db.Text
  attachmentUrl  String?
  attachmentName String?
  status         DemandStatus   @default(RECEBIDA)
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  updates DemandUpdate[]

  @@unique([organizationId, protocol])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([organizationId])
  @@map("demands")
}

model DemandUpdate {
  id             String        @id @default(cuid())
  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  demandId       String
  demand         Demand        @relation(fields: [demandId], references: [id], onDelete: Cascade)
  previousStatus DemandStatus?
  newStatus      DemandStatus
  message        String?       @db.Text
  createdById    String?
  createdBy      User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([demandId])
  @@index([organizationId])
  @@map("demand_updates")
}

// ─── Jurídico ─────────────────────────────────────────────────────────────────

enum ProcessoStatus {
  ATIVO
  SUSPENSO
  ENCERRADO
  ARQUIVADO
}

enum ProcessoOrigem {
  MANUAL
  DATAJUD
}

model Processo {
  id                  String         @id @default(cuid())
  organizationId      String?        @db.Uuid
  organization        Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  numeroProcesso      String // 20 dígitos sem formatação/separadores; único por organização
  tribunal            String         @default("TJCE")
  classe              String? // classeProcessual.nome
  assunto             String? // assuntos[0].nome
  orgaoJulgador       String?
  grau                String? // G1, G2, JE
  dataAjuizamento     DateTime?      @db.Date
  status              ProcessoStatus @default(ATIVO)
  ultimaMovimentacao  String? // movimentos[-1].nome
  dataUltimaMovim     DateTime?
  resumoPublico       String?        @db.Text // editável pelo admin, visível no portal
  observacoesInternas String?        @db.Text // nunca público
  origem              ProcessoOrigem @default(MANUAL)
  ultimaSincronizacao DateTime?
  ativo               Boolean        @default(true) // false = arquivado
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  notificacoes Notificacao[]
  multas       Multa[]

  @@unique([organizationId, numeroProcesso])
  @@index([status])
  @@index([ativo])
  @@index([organizationId])
  @@map("processos")
}

enum NotificacaoStatus {
  EMITIDA
  ENTREGUE
  RESPONDIDA
  CONTESTADA
  ARQUIVADA
}

model Notificacao {
  id               String            @id @default(cuid())
  organizationId   String?           @db.Uuid
  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  processoId       String?
  processo         Processo?         @relation(fields: [processoId], references: [id])
  bloco            String // A–I
  unidade          String // 101–108 | 201–208 | 301–308 | 401–408
  motivo           String
  descricaoInterna String?           @db.Text
  status           NotificacaoStatus @default(EMITIDA)
  dataEmissao      DateTime          @db.Date
  dataEntrega      DateTime?         @db.Date
  dataResposta     DateTime?         @db.Date
  anexoUrl         String?
  anexoNome        String?
  criadoPorId      String?
  criadoPor        User?             @relation("NotificacaoCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ativo            Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([bloco, unidade])
  @@index([organizationId])
  @@map("notificacoes")
}

enum MultaStatus {
  APLICADA
  NOTIFICADA
  CONTESTADA
  MANTIDA
  CANCELADA
  PAGA
  VENCIDA
}

model Multa {
  id               String        @id @default(cuid())
  organizationId   String?       @db.Uuid
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  processoId       String?
  processo         Processo?     @relation(fields: [processoId], references: [id])
  bloco            String
  unidade          String
  motivo           String
  descricaoInterna String?       @db.Text
  valor            Decimal       @db.Decimal(12, 2)
  status           MultaStatus   @default(APLICADA)
  dataAplicacao    DateTime      @db.Date
  dataVencimento   DateTime?     @db.Date
  dataPagamento    DateTime?     @db.Date
  anexoUrl         String?
  anexoNome        String?
  criadoPorId      String?
  criadoPor        User?         @relation("MultaCriador", fields: [criadoPorId], references: [id], onDelete: SetNull)
  ativo            Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([bloco, unidade])
  @@index([organizationId])
  @@map("multas")
}

enum JuridicoEntidade {
  PROCESSO
  NOTIFICACAO
  MULTA
  SINCRONIZACAO
}

model JuridicoAuditoria {
  id             String           @id @default(cuid())
  organizationId String?          @db.Uuid
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entidade       JuridicoEntidade
  entidadeId     String
  acao           String // CRIACAO | EDICAO | MUDANCA_STATUS | SINCRONIZACAO | ARQUIVAMENTO | CANCELAMENTO | PAGAMENTO
  valorAnterior  Json?
  valorNovo      Json?
  usuarioId      String?
  usuario        User?            @relation("JuridicoAuditor", fields: [usuarioId], references: [id], onDelete: SetNull)
  observacao     String?          @db.Text
  createdAt      DateTime         @default(now())

  @@index([entidade, entidadeId])
  @@index([createdAt])
  @@index([organizationId])
  @@map("juridico_auditoria")
}

// ─── Organizações (condomínios) ───────────────────────────────────────────────

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

/// Condomínio cliente do Orken COND. O slug é o mesmo da Orken Platform e é o
/// caminho do portal (`/{slug}`). Desativada responde como inexistente.
model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  slug                   String             @unique
  name                   String
  shortName              String
  status                 OrganizationStatus @default(ACTIVE)
  /// Organização na Orken Platform (entrada da equipe pelo Orken ID).
  platformOrganizationId String?            @unique @db.Uuid
  /// Prefixo dos protocolos da Central de Demandas ("RST" → RST-2026-K7M9Q2).
  protocolPrefix         String             @unique
  /// Tribunal do DataJud para a sincronização de processos.
  datajudTribunal        String             @default("TJCE")
  /// Cor complementar da identidade do condomínio no portal (hex).
  accentColor            String?
  /// Blocos e unidades (lib/units.ts). Sem planta, multas e notificações só conferem o formato.
  unitLayout             Json?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  users              User[]
  categorias         Categoria[]
  lancamentos        Lancamento[]
  pareceres          Parecer[]
  planilhasDownload  PlanilhaDownload[]
  avisos             Aviso[]
  obras              Obra[]
  propostas          Proposta[]
  enquetes           Enquete[]
  opcoesEnquete      OpcaoEnquete[]
  votosEnquete       VotoEnquete[]
  membros            Membro[]
  demands            Demand[]
  demandUpdates      DemandUpdate[]
  processos          Processo[]
  notificacoes       Notificacao[]
  multas             Multa[]
  juridicoAuditorias JuridicoAuditoria[]
  configPortal       ConfigPortal?

  @@map("organizations")
}
