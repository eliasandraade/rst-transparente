# ─── Banco de dados (PostgreSQL via Railway) ──────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# ─── Orken ID e Orken Platform (docs/orken-cond/identidade.md) ───────────────
# Todas ou nenhuma. Nenhuma: só o login local da equipe, sem o botão da conta Orken.
# ORKEN_ISSUER="https://account.orken.com.br"
# ORKEN_CLIENT_ID="orken-cond-web"
# ORKEN_CLIENT_SECRET=""
# PLATFORM_API_URL="https://api.orken.com.br"
# ORKEN_SERVICE_CLIENT_ID="orken-cond-service"
# ORKEN_SERVICE_CLIENT_SECRET=""
# APP_BASE_URL="https://cond.orken.com.br"
# PLATFORM_EVENTS_SYNC="on"

# ─── Cloudinary (storage de PDFs) ────────────────────────────────────────────
# Obtenha em: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="seu-api-secret"

# ─── Redis (rate limit compartilhado entre réplicas; obrigatório em produção) ──
REDIS_URL="redis://localhost:6379"

# ─── IP do cliente: cabeçalho que o edge sobrescreve (Railway: x-real-ip) ──────
CLIENT_IP_HEADER="x-real-ip"

# ─── DataJud (sincronização de processos) ─────────────────────────────────────
DATAJUD_API_KEY=""

# ─── Seed de demonstração (só desenvolvimento local; nunca em produção) ───────
# npm run db:seed:demo com ALLOW_DEMO_SEED=1. Sem valores padrão: escolha os seus.
ALLOW_DEMO_SEED=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# Host antigo de um condomínio só: caminhos antigos (/financeiro, /admin/...) recebem
# 308 para /{slug}/... Lista separada por vírgula, host=slug.
# LEGACY_HOST_ORGANIZATION="www.transparenciarst.com.br=santissima-trindade"
